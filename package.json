{
  "name": "wla-vue",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --fix",
    "format": "prettier --write src/",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,vue}": [
      "eslint --fix",
      "prettier --write"
    ],
    "!(*.js|*.vue)": "prettier --write --ignore-unknown"
  },
  "dependencies": {
    "@vitejs/plugin-vue": "^6.0.1",
    "pinia": "^3.0.3",
    "sass-embedded": "^1.90.0",
    "vite": "^7.1.0",
    "vite-plugin-vue-devtools": "^8.0.0",
    "vue": "^3.5.18"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@pinia/testing": "^1.0.3",
    "@vue/test-utils": "^2.4.10",
    "eslint": "^10.4.1",
    "eslint-plugin-vue": "^10.9.1",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^16.1.4",
    "prettier": "^3.6.2",
    "prettier-plugin-css-order": "^2.1.2",
    "vitest": "^4.1.7"
  }
}
